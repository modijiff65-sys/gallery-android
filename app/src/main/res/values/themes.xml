<resources>
    <!-- LIGHT variant -->
    <style name="Theme.Gallery" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accentDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>

        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="gSurface">#FFFFFF</item>
        <item name="gSurfaceAlt">#F2F3F7</item>
        <item name="gCard">#F4F5F9</item>
        <item name="gOnSurface">#14161C</item>
        <item name="gMuted">#6B7280</item>
        <item name="gDivider">#E7E9F0</item>
        <item name="gChipBg">#EEF0F6</item>
        <item name="gNavBg">#FFFFFF</item>
        <item name="gBar">#F2F3F7</item>
    </style>

    <!-- AMOLED pure black -->
    <style name="Theme.Gallery.Amoled" parent="Theme.Gallery">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="gSurface">#000000</item>
        <item name="gSurfaceAlt">#0E0E10</item>
        <item name="gCard">#141416</item>
        <item name="gOnSurface">#FFFFFF</item>
        <item name="gMuted">#9AA0A6</item>
        <item name="gDivider">#1F1F23</item>
        <item name="gChipBg">#1B1B1E</item>
        <item name="gNavBg">#000000</item>
        <item name="gBar">#1A1A1C</item>
    </style>

    <style name="Theme.Gallery.Viewer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="gSurface">#000000</item>
        <item name="gSurfaceAlt">#141416</item>
        <item name="gCard">#141416</item>
        <item name="gOnSurface">#FFFFFF</item>
        <item name="gMuted">#9AA0A6</item>
        <item name="gDivider">#2A2A2E</item>
        <item name="gChipBg">#1B1B1E</item>
        <item name="gBar">#2A2A2C</item>
    </style>

    <style name="ShapeAppearance.Gallery.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Gallery.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.Gallery.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.Gallery.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
