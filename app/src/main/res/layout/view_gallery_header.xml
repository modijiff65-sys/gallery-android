<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/hdrTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="?attr/gOnSurface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/hdrSearch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/gOnSurface" />

        <ImageView
            android:id="@+id/hdrMulti"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Multi-select"
            android:padding="10dp"
            android:src="@drawable/ic_checkbox"
            app:tint="?attr/gOnSurface" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/hdrAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/gChipBg"
            android:padding="7dp"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Gallery.Circle"
            app:tint="?attr/gOnSurface" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/hdrPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/pillPhotos"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/pill_photos"
                android:textSize="14sp"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="40dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/pillAlbums"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/pill_albums"
                android:textSize="14sp"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="40dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/pillCloud"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/pill_cloud"
                android:textSize="14sp"
                app:chipCornerRadius="20dp"
                app:chipMinHeight="40dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
</LinearLayout>
