<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/catCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/gSurfaceAlt"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Gallery.Card" />

        <ImageView
            android:id="@+id/catIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_videocam"
            android:visibility="gone"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/catTitle"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/gOnSurface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/catCount"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/gMuted"
        android:textSize="10sp" />
</LinearLayout>
